{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "rdbg",
      "name": "Debug Homebrew Command",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "rdbgPath": "${workspaceFolder}/Library/Homebrew/shims/gems/rdbg",
      "command": "brew",
      "script": "debugger",
      "args": [
        "--",
        "${fileBasenameNoExtension}"
      ],
      "askParameters": true,
      "showDebuggerOutput": true,
      "env": {
        "HOMEBREW_DEVELOPER": "1",
        "HOMEBREW_NO_AUTO_UPDATE": "1",
        "TMPDIR": "/private/tmp"
      }
    },
    {
      "type": "rdbg",
      "name": "Attach to Homebrew Debugger",
      "request": "attach",
      "rdbgPath": "${workspaceFolder}/Library/Homebrew/shims/gems/rdbg",
      "debugPort": "127.0.0.1:12345",
      "cwd": "${workspaceFolder}",
      "env": {
        "TMPDIR": "/private/tmp"
      },
      "showDebuggerOutput": true
    }
  ]
}
